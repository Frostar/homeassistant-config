---
extends: default

ignore: |
  www/
  zigbee2mqtt/
  custom_components/

rules:
  document-start: disable
  line-length: disable
  truthy: disable
  comments:
    min-spaces-from-content: 1
  comments-indentation: disable
  indentation:
    spaces: 2
    indent-sequences: whatever
  braces:
    min-spaces-inside: 0
    max-spaces-inside: 1
  brackets:
    min-spaces-inside: 0
    max-spaces-inside: 1
